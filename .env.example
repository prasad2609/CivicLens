# ==============================================================================
# CivicLens - Constituency Accountability & Civic Transparency Platform
# Environment Configuration
# ==============================================================================
# CivicLens is engineered to run 100% locally with ZERO paid dependencies!
# A high-performance, file-backed ACID database (src/data/server_db.json)
# is enabled by default for offline, zero-configuration local development.
#
# Free Cloud Deployment (Supabase PostgreSQL):
# 1. Create a free tier project at https://supabase.com
# 2. Run supabase/schema.sql and supabase/seed.sql in the Supabase SQL Editor
# 3. Copy your project URL and API keys from Project Settings > API
# 4. Set DATABASE_MODE="supabase" and supply the credentials below.

NEXT_PUBLIC_APP_NAME="CivicLens"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Mode: 'local' (server_db.json) or 'supabase'
DATABASE_MODE="local"

# Supabase Free-Tier Credentials (Optional)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key"
